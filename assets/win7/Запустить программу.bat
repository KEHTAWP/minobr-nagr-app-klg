@echo off
rem ==================================================================
rem  Запуск программы на Windows 7.
rem  Файл сохранён в кодировке CP866 - так его читает командная строка.
rem
rem  Что он делает:
rem    1) проверяет, есть ли в системе Universal C Runtime -
rem       без него Windows 7 не даёт запуститься самой программе;
rem    2) если его нет - ставит вложенное обновление KB2999226;
rem    3) запускает программу.
rem
rem  Программу и обновление ищет рядом с собой по маске *.exe и *.msu,
rem  поэтому в командах нет русских букв - так надёжнее.
rem
rem  Отложенное расширение переменных здесь намеренно не включено:
rem  оно портит пути, в которых встречается восклицательный знак.
rem ==================================================================
chcp 866 >nul
title Портал наград - запуск
setlocal
cd /d "%~dp0"

set "CRT=%SystemRoot%\System32\api-ms-win-crt-runtime-l1-1-0.dll"

set "EXE="
for %%F in ("%~dp0*.exe") do set "EXE=%%~fF"
if not defined EXE goto noexe

if not exist "%SystemRoot%\SysWOW64\cmd.exe" goto x86
if exist "%CRT%" goto run

rem ---------------- обновление отсутствует ----------------
cls
echo.
echo  ================================================================
echo    Windows 7 нужно один раз обновить
echo  ================================================================
echo.
echo    В этой системе нет компонента Universal C Runtime.
echo    Без него программа не запускается - Windows сообщает,
echo    что не хватает файла api-ms-win-crt-runtime-l1-1-0.dll.
echo.
echo    Это официальное обновление Microsoft (KB2999226).
echo    Оно лежит рядом, интернет для установки не нужен.
echo.

set "MSU="
for %%F in ("%~dp0*.msu") do set "MSU=%%~fF"
if not defined MSU goto nomsu

echo    Сейчас откроется установщик обновления Windows.
echo    Согласитесь на установку и дождитесь окончания -
echo    это занимает несколько минут.
echo.
echo    Если система спросит разрешение администратора,
echo    ответьте "Да".
echo.
pause

start "" /wait wusa.exe "%MSU%"

if exist "%CRT%" goto installed
goto notinstalled

:installed
cls
echo.
echo    Обновление установлено. Запускаем программу.
echo.
goto run

:notinstalled
echo.
echo  ================================================================
echo    Обновление пока не установилось
echo  ================================================================
echo.
echo    Возможные причины:
echo.
echo      - установка была отменена;
echo      - компьютеру нужно перезагрузиться, чтобы её завершить;
echo      - на Windows 7 не установлен пакет обновления SP1
echo        (тогда сначала нужен именно он).
echo.
echo    Что сделать: перезагрузите компьютер и запустите
echo    этот файл ещё раз. Если не поможет - установите
echo    обновление вручную двойным щелчком по файлу
echo    с расширением .msu в этой же папке.
echo.
pause
exit /b 1

:nomsu
echo.
echo    ВНИМАНИЕ: файла обновления рядом нет.
echo.
echo    Он должен лежать в этой же папке и называться
echo    примерно так:  Windows6.1-KB2999226-x64.msu
echo.
echo    Скачать его можно на другом компьютере в Центре
echo    загрузки Microsoft по номеру KB2999226 и принести
echo    на флешке вместе с программой.
echo.
pause
exit /b 1

:run
echo.
echo    Запускаем программу. Это окно можно закрыть.
echo.
start "" "%EXE%" %*
exit /b 0

:noexe
echo.
echo    ОШИБКА: рядом с этим файлом нет программы.
echo.
echo    В одной папке должны лежать:
echo      - этот файл запуска;
echo      - сама программа (файл с расширением .exe);
echo      - обновление Windows (файл с расширением .msu).
echo.
echo    Скорее всего, из папки скопировали только часть файлов.
echo.
pause
exit /b 1

:x86
echo.
echo    Эта программа собрана для 64-разрядной Windows,
echo    а на этом компьютере стоит 32-разрядная.
echo.
echo    Запустить её здесь не получится. Покажите это
echo    сообщение тому, кто передал вам программу.
echo.
pause
exit /b 1
