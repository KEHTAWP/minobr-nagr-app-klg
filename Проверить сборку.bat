@echo off
rem Самопроверка собранных приложений (запуск двойным щелчком).
rem Файл сохранён в кодировке CP866 - так его читает командная строка Windows.
rem Проверяет все сборки, найденные в папке dist, а также exe рядом с собой.

title Портал наград - проверка сборки
setlocal enabledelayedexpansion
cd /d "%~dp0"

set FOUND=0

if exist "dist" (
    rem программы лежат либо прямо в dist, либо в собранной папке-комплекте
    for /r "dist" %%F in (*.exe) do (
        set /a FOUND+=1
        echo.
        echo ================================================================
        echo   Проверяем: %%~nxF
        echo ================================================================
        "%%~fF" --selftest
    )
)

if %FOUND%==0 (
    for %%F in ("*.exe") do (
        set /a FOUND+=1
        echo.
        echo ================================================================
        echo   Проверяем: %%~nxF
        echo ================================================================
        "%%~fF" --selftest
    )
)

if %FOUND%==0 goto notfound

echo.
echo Проверено сборок: %FOUND%
echo Во всех отчётах должны быть только строки "в порядке".
echo.
pause
exit /b 0

:notfound
echo.
echo   Не найдено ни одной собранной программы.
echo.
echo   Положите этот файл проверки:
echo     - либо в папку проекта, где есть подпапка dist
echo     - либо рядом с готовым файлом программы
echo.
echo   Если приложение ещё не собрано, запустите
echo   "Собрать exe.bat" или "Собрать exe для Windows 7.bat".
echo.
pause
exit /b 1
